# Copy to .env.local and fill in. Leave GAS URL or Client ID empty to run in Local Demo Mode.

# Apps Script web app URL (Deploy -> Web app -> .../exec)
VITE_GAS_API_URL=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173 and your production URL
VITE_GOOGLE_CLIENT_ID=

# College Google Workspace domain; the sign-in picker defaults to it and the backend enforces it
VITE_ALLOWED_DOMAIN=iimu.ac.in

# Set to true to force Local Demo Mode even when the values above are set
VITE_FORCE_DEMO=false

# "/" for Vercel; "/Work-Tracker/" for GitHub Pages (the workflow sets this automatically)
VITE_BASE_PATH=/
